{
  "name": "rxjs-leak-finder",
  "version": "0.1.0",
  "description": "Find unsubscribed RxJS subscriptions in Angular dev-mode apps. One line in main.ts, no Chrome extension.",
  "type": "module",
  "main": "./dist/runtime/index.js",
  "types": "./dist/runtime/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js"
    }
  },
  "bin": {
    "rxjs-leak-finder": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.runtime.json && tsc -p tsconfig.cli.json && node scripts/build-dashboard.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "files": [
    "dist/",
    "README.md",
    "HOW_IT_WORKS.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/FlorinCiocirlan/rxjs-leak-finder.git",
    "directory": "packages/rxjs-leak-detector"
  },
  "homepage": "https://github.com/FlorinCiocirlan/rxjs-leak-finder#readme",
  "bugs": {
    "url": "https://github.com/FlorinCiocirlan/rxjs-leak-finder/issues"
  },
  "devDependencies": {
    "@rld/analyzer-core": "workspace:*",
    "@rld/panel-ui": "workspace:*",
    "happy-dom": "^14.10.1",
    "lit": "^3.1.0",
    "rxjs": "^7.8.1",
    "source-map": "^0.7.4",
    "vite": "^5.2.0"
  },
  "keywords": [
    "rxjs",
    "angular",
    "memory-leak",
    "subscription",
    "devtools",
    "leak-detector",
    "observable"
  ],
  "license": "MIT",
  "author": "Florin Ciocirlan"
}
